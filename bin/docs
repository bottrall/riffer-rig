#!/usr/bin/env bash
# Builds the docs through `rake docs`; --serve serves them, --check checks them.
set -euo pipefail
cd "$(dirname "$0")/.."
# shellcheck source=lib/stack.sh
source bin/lib/stack.sh

task=docs
for arg in "$@"; do
  case $arg in
    --serve | --check)
      if [[ $task != docs ]]; then fail "takes --serve or --check, not both"; fi
      task=docs:${arg#--}
      ;;
    --only=ruby) ;;
    --only=ts) not_applicable "docs build through Rake, and --only=ts excludes it" ;;
    *) fail "unknown argument $arg; takes --serve or --check" ;;
  esac
done

if ! has_ruby; then not_applicable "no Gemfile, so no rake $task task"; fi
if ! has_rake_task "$task"; then not_applicable "no rake $task task"; fi

exec bundle exec rake "$task"
