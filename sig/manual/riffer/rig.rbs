# rbs-inline does not emit `extend self` for modules that use it, so their
# instance methods aren't visible as singleton methods (e.g.
# `Riffer::Rig::Credentials.anthropic_api_key`). Reopening each module here to
# `extend` itself restores that, matching the runtime behaviour.

module Riffer::Rig::Credentials
  extend ::Riffer::Rig::Credentials
end

module Riffer::Rig::CLI
  extend ::Riffer::Rig::CLI
end

module Riffer::Rig::Settings
  extend ::Riffer::Rig::Settings
end

module Riffer::Rig::UI::Banner
  extend ::Riffer::Rig::UI::Banner
end

# Namespace modules autovivified by Zeitwerk in Ruby; RBS needs them declared
# explicitly so the compact `Riffer::Rig::UI::*` / `Riffer::Rig::Tools::*`
# signatures resolve.

module Riffer::Rig::UI
end

module Riffer::Rig::Tools
end
