# rbs-inline does not emit `extend self`, so without this reopen the module's
# methods aren't visible as singleton methods.

module Riffer::Rig::Mcp
  extend ::Riffer::Rig::Mcp

  interface _Registry
    def register: (Hash[Symbol, untyped]) -> Riffer::Mcp::Registration
    def unregister: (String) -> void
  end
end
