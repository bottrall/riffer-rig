# The Runtime surface the counter reads and the footer it draws on;
# Riffer::Rig::Runtime and Riffer::Rig::Terminal::Frame are the implementations.

class Riffer::Rig::Terminal::JobCounter
  interface _Runtime
    def on_message: () { (::Riffer::Messages::Base) -> void } -> nil
    def on_job_exit: () { (::Riffer::Rig::Runtime::JobCompletion) -> void } -> nil
    def running_job_count: () -> Integer
  end

  interface _Footer
    def jobs: (Integer count) -> void
  end
end
