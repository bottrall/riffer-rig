# Zeitwerk autovivifies this namespace module in Ruby; RBS needs it declared
# explicitly so the compact `Riffer::Rig::Support::*` signatures resolve.

module Riffer::Rig::Support
  interface _ToH
    def to_h: () -> Hash[Symbol, untyped]
  end

  interface _TypedValue[T]
    def class: () -> _Schema[T]
    def public_send: (Symbol name) -> untyped
  end

  interface _Schema[T]
    def type: () -> T
    def attributes: () -> Array[Symbol]
  end
end
