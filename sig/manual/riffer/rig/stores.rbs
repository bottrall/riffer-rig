# Zeitwerk autovivifies this namespace module in Ruby; RBS needs it declared
# explicitly so the compact `Riffer::Rig::Stores::*` signatures resolve.

module Riffer::Rig::Stores
  type entry = Header | MessageEntry | ModelEntry | SkillEntry
  type entry_type = singleton(Header) | singleton(MessageEntry) | singleton(ModelEntry) | singleton(SkillEntry)

  interface _Clock
    def now: () -> Time
  end

  interface _Stamped
    def recorded_at: () -> String?
  end

  interface _Store
    def append: (String id, entry entry) -> void
    def read: (String id) -> Array[entry]
    def list: (?cwd: String?) -> Array[Header]
    def delete: (String id) -> void
  end
end
