# rbs-inline does not emit `extend self` for modules that use it, so their
# instance methods aren't visible as singleton methods (e.g.
# `Riffer::Rig::Credentials.anthropic_api_key`). Reopening the module here to
# `extend` itself restores that, matching the runtime behaviour.

module Riffer::Rig::Credentials
  extend ::Riffer::Rig::Credentials
end
