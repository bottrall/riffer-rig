# rbs-inline does not emit `extend self` for modules that use it, so their
# instance methods aren't visible as singleton methods (e.g.
# `Riffer::Rig::Settings.load`). Reopening the module here to `extend` itself
# restores that, matching the runtime behaviour.

module Riffer::Rig::Settings
  extend ::Riffer::Rig::Settings
end
