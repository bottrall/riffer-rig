# Zeitwerk ships no RBS, so declare the slice of the loader API used to set up
# autoloading in lib/riffer/rig.rb.

module Zeitwerk
  class Loader
    def self.for_gem_extension: (Module namespace) -> instance
    def ignore: (*String) -> void
    def inflector: () -> untyped
    def setup: () -> void
  end
end
