# aws-sdk-bedrockruntime is an optional SDK outside the bundle, so its own RBS
# never reaches the collection. Declares only what `Riffer::Rig::Clients`
# constructs.

module Aws
  class StaticTokenProvider
    def initialize: (String token) -> void
  end

  module BedrockRuntime
    class Client
      def initialize: (**untyped options) -> void
    end
  end
end
